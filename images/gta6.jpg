    </div>
</section>

<style>
.gaming-extra {
    background: #121212;
    color: white;
    padding: 30px 15px;
    font-family: Arial, sans-serif;
}

.gaming-extra h1 {
    color: #00e5ff;
    text-align: center;
}

#newsSearch {
    display: block;
    width: 90%;
    max-width: 500px;
    margin: 25px auto;
    padding: 14px;
    border-radius: 8px;
    border: 2px solid #00e5ff;
    background: #222;
    color: white;
}

.extra-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 20px;
}

.extra-card {
    background: #222;
    border-radius: 12px;
    overflow: hidden;
    padding-bottom: 20px;
    border: 1px solid #00e5ff;
}

.extra-card img {
    width: 100%;
    height: 170px;
    object-fit: cover;
}

.extra-card h2,
.extra-card p {
    margin: 15px;
}

.extra-card h2 {
    color: #00e5ff;
}

.extra-card a {
    display: inline-block;
    margin: 0 15px;
    padding: 10px;
    background: #00e5ff;
    color: black;
    text-decoration: none;
    border-radius: 5px;
}
</style>

<script>
function searchNews() {
    let input = document.getElementById("newsSearch")
        .value.toLowerCase();

    let cards = document.querySelectorAll(".extra-card");

    cards.forEach(card => {
        let text = card.innerText.toLowerCase();

        card.style.display =
            text.includes(input) ? "block" : "none";
    });
}
</script><!-- ACTUALITES BERTIN GAMING -->

