<section class="gaming-extra">
    <h1>🎮 EXPLORER LES ACTUALITÉS</h1>

    <input
        type="text"
        id="newsSearch"
        placeholder="🔎 Rechercher une actualité..."
        onkeyup="searchNews()"
    >

    <div class="extra-grid" id="newsGrid">

        <article class="extra-card">
            <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?w=800"
                 alt="Gaming">
